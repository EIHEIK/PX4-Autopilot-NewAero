#!/bin/sh
# shellcheck disable=SC2154

echo "INFO  [init] Gazebo simulator"

# Enforce minimum gz version as Harmonic (gz-sim8)
MIN_GZ_VERSION="8.0.0"
GZ_SIM_VERSION=$(gz sim --versions 2>/dev/null | head -n 1 | tr -d ' ')

if [ -z "$GZ_SIM_VERSION" ]; then
    echo "ERROR [init] Gazebo gz sim not found. Please install gz-harmonic"
    exit 1
fi

# Use sort compare, check that MIN_GZ_VERSION is ordered last
if [ "$(printf '%s\n' "$GZ_SIM_VERSION" "$MIN_GZ_VERSION" | sort -V | head -n1)" = "$MIN_GZ_VERSION" ]; then
	gz_command="gz"
	gz_sub_command="sim"

	# Specify render engine if `GZ_SIM_RENDER_ENGINE` is set
	# (for example, if you want to use Ogre 1.x instead of Ogre 2.x):
	if [ -n "${PX4_GZ_SIM_RENDER_ENGINE}" ]; then
		echo "INFO  [init] Setting Gazebo render engine to '${PX4_GZ_SIM_RENDER_ENGINE}'!"
		gz_sub_command="${gz_sub_command} --render-engine ${PX4_GZ_SIM_RENDER_ENGINE}"
	fi
else
    echo "ERROR [init] Gazebo gz sim version is too old ($GZ_SIM_VERSION). Minimum required version is $MIN_GZ_VERSION"
    exit 1
fi

# Look for an already running world
get_gz_world() {
	gz_world=$( ${gz_command} topic -l | grep -m 1 -e "^/world/.*/clock" | sed 's/\/world\///g; s/\/clock//g' )
}

# If not standalone
if [ -z "${PX4_GZ_STANDALONE}" ]; then

	get_gz_world

	# shellcheck disable=SC2153
	# Setup gz environment variables — must run regardless of whether
	# Gazebo is already running, so that PX4_GZ_MODELS/PX4_GZ_WORLDS
	# are available for model spawning.
	if [ -f ./gz_env.sh ]; then
		. ./gz_env.sh

	elif [ -f ../gz_env.sh ]; then
		. ../gz_env.sh
	fi

	if [ -z "${gz_world}" ] && [ -n "${PX4_GZ_WORLD}" ]; then

		echo "INFO  [init] Starting gazebo with world: ${PX4_GZ_WORLDS}/${PX4_GZ_WORLD}.sdf"

		${gz_command} ${gz_sub_command} --verbose=${GZ_VERBOSE:=1} -r -s "${PX4_GZ_WORLDS}/${PX4_GZ_WORLD}.sdf" &

		if [ -z "${HEADLESS}" ]; then
			echo "INFO  [init] Starting gz gui"
			${gz_command} ${gz_sub_command} -g > /dev/null 2>&1 &
		fi

	else
		# Gazebo is already running
		echo "INFO  [init] gazebo already running world: ${gz_world}"
		PX4_GZ_WORLD=${gz_world}
	fi

else
	echo "INFO  [init] Standalone PX4 launch, waiting for Gazebo"
fi

# Wait for Gazebo world to be ready before proceeding
check_scene_info() {

	get_gz_world

	if [ -n "${PX4_GZ_STANDALONE}" ] && [ -n "${gz_world}" ]; then
		PX4_GZ_WORLD=${gz_world}
	fi

	SERVICE_INFO=$(${gz_command} service -i --service "/world/${PX4_GZ_WORLD}/scene/info" 2>&1)
	if echo "$SERVICE_INFO" | grep -q "Service providers"; then
		return 0
	else
		return 1
	fi
}

ATTEMPTS=30
while [ $ATTEMPTS -gt 0 ]; do
	if check_scene_info; then
		echo "INFO  [init] Gazebo world is ready"
		break
	fi
	ATTEMPTS=$((ATTEMPTS-1))
	if [ $ATTEMPTS -eq 0 ]; then
		echo "ERROR [init] Timed out waiting for Gazebo world"
		exit 1
	fi
	echo "INFO  [init] Waiting for Gazebo world..."
	sleep 1
done

# Optionally impose WGS84 coordinates after the world is available. This is
# intentionally done at run time as well as in the world SDF: gz-sim reuses an
# existing server, and in that case the SDF selected for this launch is not
# reloaded. Airframes that do not export both variables retain old behavior.
if [ "${PX4_GZ_SET_HOME_COORDINATES:-1}" != "0" ] && { [ -n "${PX4_GZ_HOME_LAT}" ] || [ -n "${PX4_GZ_HOME_LON}" ]; }; then
	if [ -z "${PX4_GZ_HOME_LAT}" ] || [ -z "${PX4_GZ_HOME_LON}" ]; then
		echo "ERROR [init] PX4_GZ_HOME_LAT and PX4_GZ_HOME_LON must be set together"
		exit 1
	fi

	PX4_GZ_HOME_ALT=${PX4_GZ_HOME_ALT:=0}
	PX4_GZ_HOME_HEADING=${PX4_GZ_HOME_HEADING:=0}
	echo "INFO  [init] Setting Gazebo WGS84 origin: ${PX4_GZ_HOME_LAT}, ${PX4_GZ_HOME_LON}, ${PX4_GZ_HOME_ALT} m"
	SPHERICAL_RESULT=$(${gz_command} service -s "/world/${PX4_GZ_WORLD}/set_spherical_coordinates" \
			--reqtype gz.msgs.SphericalCoordinates --reptype gz.msgs.Boolean --timeout 5000 \
			--req "surface_model: EARTH_WGS84, latitude_deg: ${PX4_GZ_HOME_LAT}, longitude_deg: ${PX4_GZ_HOME_LON}, elevation: ${PX4_GZ_HOME_ALT}, heading_deg: ${PX4_GZ_HOME_HEADING}" 2>&1)

	if ! echo "${SPHERICAL_RESULT}" | grep -q "data: true"; then
		echo "ERROR [init] Failed to set Gazebo WGS84 origin: ${SPHERICAL_RESULT}"
		exit 1
	fi
elif [ "${PX4_GZ_SET_HOME_COORDINATES:-1}" = "0" ]; then
	echo "INFO  [init] Keeping Gazebo WGS84 origin from the loaded world SDF"
fi

# Optionally override the Gazebo physics step before spawning the model. This
# is opt-in so existing airframes retain the world's configured step size.
# Gazebo's Physics request is not a patch: omitted fields fall back to protobuf
# defaults. Preserve all default-world fields so gravity cannot be disabled.
if [ -n "${PX4_GZ_MAX_STEP_SIZE}" ]; then
	echo "INFO  [init] Setting Gazebo max step size: ${PX4_GZ_MAX_STEP_SIZE} s"
	PHYSICS_UPDATE_RATE=$(awk "BEGIN { print 1.0 / ${PX4_GZ_MAX_STEP_SIZE} }")
	PHYSICS_RESULT=$(${gz_command} service -s "/world/${PX4_GZ_WORLD}/set_physics" --reqtype gz.msgs.Physics \
			--reptype gz.msgs.Boolean --timeout 5000 \
			--req "max_step_size: ${PX4_GZ_MAX_STEP_SIZE}, real_time_factor: 1.0, real_time_update_rate: ${PHYSICS_UPDATE_RATE}, enable_physics: true, gravity: {x: 0, y: 0, z: -9.8}, magnetic_field: {x: 0.000006, y: 0.000023, z: -0.000042}" 2>&1)

	if ! echo "${PHYSICS_RESULT}" | grep -q "data: true"; then
		echo "ERROR [init] Failed to set Gazebo max step size: ${PHYSICS_RESULT}"
		exit 1
	fi
fi

# Start gz_bridge - either spawn a model or connect to existing one
if [ -n "${PX4_SIM_MODEL#*gz_}" ] && [ -z "${PX4_GZ_MODEL_NAME}" ]; then
	# Spawn a model
	MODEL_NAME="${PX4_SIM_MODEL#*gz_}"
	MODEL_NAME_INSTANCE="${MODEL_NAME}_${px4_instance}"

	POSE_ARG=""
	if [ -n "${PX4_GZ_MODEL_POSE}" ]; then
		pos_x=$(echo "${PX4_GZ_MODEL_POSE}" | awk -F',' '{print $1}')
		pos_y=$(echo "${PX4_GZ_MODEL_POSE}" | awk -F',' '{print $2}')
		pos_z=$(echo "${PX4_GZ_MODEL_POSE}" | awk -F',' '{print $3}')
		roll=$(echo "${PX4_GZ_MODEL_POSE}" | awk -F',' '{print $4}')
		pitch=$(echo "${PX4_GZ_MODEL_POSE}" | awk -F',' '{print $5}')
		yaw=$(echo "${PX4_GZ_MODEL_POSE}" | awk -F',' '{print $6}')
		pos_x=${pos_x:-0}
		pos_y=${pos_y:-0}
		pos_z=${pos_z:-0}
		roll=${roll:-0}
		pitch=${pitch:-0}
		yaw=${yaw:-0}

		# EntityFactory accepts a quaternion, while PX4_GZ_MODEL_POSE uses the
		# conventional x,y,z,roll,pitch,yaw representation in radians.
		quat=$(awk -v r="${roll}" -v p="${pitch}" -v y="${yaw}" 'BEGIN {
			cr=cos(r/2); sr=sin(r/2); cp=cos(p/2); sp=sin(p/2); cy=cos(y/2); sy=sin(y/2);
			printf "%.17g %.17g %.17g %.17g", sr*cp*cy-cr*sp*sy, cr*sp*cy+sr*cp*sy, cr*cp*sy-sr*sp*cy, cr*cp*cy+sr*sp*sy
		}')
		quat_x=$(echo "${quat}" | awk '{print $1}')
		quat_y=$(echo "${quat}" | awk '{print $2}')
		quat_z=$(echo "${quat}" | awk '{print $3}')
		quat_w=$(echo "${quat}" | awk '{print $4}')

		POSE_ARG=", pose: { position: { x: ${pos_x}, y: ${pos_y}, z: ${pos_z} }, orientation: { x: ${quat_x}, y: ${quat_y}, z: ${quat_z}, w: ${quat_w} } }"
		echo "INFO  [init] Spawning model at pose: ${pos_x} ${pos_y} ${pos_z} ${roll} ${pitch} ${yaw}"
	fi

	MODEL_SDF_FILE="${PX4_GZ_MODELS}/${MODEL_NAME}/model.sdf"

	# Allow repository-local simulation models without modifying the gz submodule.
	# PX4_GZ_MODELS is generated as <repo>/Tools/simulation/gz/models, so this
	# derives <repo>/simulation_models/models and works after cloning elsewhere.
	if [ ! -f "${MODEL_SDF_FILE}" ]; then
		PX4_REPO_MODELS="${PX4_GZ_MODELS%/Tools/simulation/gz/models}/simulation_models/models"
		if [ -f "${PX4_REPO_MODELS}/${MODEL_NAME}/model.sdf" ]; then
			MODEL_SDF_FILE="${PX4_REPO_MODELS}/${MODEL_NAME}/model.sdf"
		fi
	fi

	if [ ! -f "${MODEL_SDF_FILE}" ]; then
		echo "ERROR [init] Model not found: ${MODEL_NAME}"
		echo "ERROR [init] Checked: ${PX4_GZ_MODELS}/${MODEL_NAME}/model.sdf"
		echo "ERROR [init] Checked repository path: ${PX4_GZ_MODELS%/Tools/simulation/gz/models}/simulation_models/models/${MODEL_NAME}/model.sdf"
		exit 1
	fi

	echo "INFO  [init] Spawning model"
	echo "INFO  [init] Using model file: ${MODEL_SDF_FILE}"

	# Spawn model
	${gz_command} service -s "/world/${PX4_GZ_WORLD}/create" --reqtype gz.msgs.EntityFactory \
			--reptype gz.msgs.Boolean --timeout 5000 \
			--req "sdf_filename: \"${MODEL_SDF_FILE}\", name: \"${MODEL_NAME_INSTANCE}\", allow_renaming: false${POSE_ARG}" > /dev/null 2>&1

	# Wait for model to spawn
	sleep 1

	# Start gz_bridge
	if ! gz_bridge start -w "${PX4_GZ_WORLD}" -n "${MODEL_NAME_INSTANCE}"; then
		echo "ERROR [init] gz_bridge failed to start and spawn model"
		exit 1
	fi

	# Set physics parameters for faster-than-realtime simulation if needed
	if [ -n "${PX4_SIM_SPEED_FACTOR}" ]; then
		echo "INFO  [init] Setting simulation speed factor: ${PX4_SIM_SPEED_FACTOR}"
		${gz_command} service -s "/world/${PX4_GZ_WORLD}/set_physics" --reqtype gz.msgs.Physics \
					--reptype gz.msgs.Boolean --timeout 5000 \
					--req "real_time_factor: ${PX4_SIM_SPEED_FACTOR}" > /dev/null 2>&1
	fi

	# Set up camera to follow the model if requested
	if [ -n "${PX4_GZ_FOLLOW}" ]; then

		echo "INFO  [init] Setting camera to follow ${MODEL_NAME_INSTANCE}"

		# Set camera to follow the model
		${gz_command} service -s "/gui/follow" --reqtype gz.msgs.StringMsg \
				--reptype gz.msgs.Boolean --timeout 5000 \
				--req "data: \"${MODEL_NAME_INSTANCE}\"" > /dev/null 2>&1

		# Set default camera offset if not specified
		follow_x=${PX4_GZ_FOLLOW_OFFSET_X:--2.0}
		follow_y=${PX4_GZ_FOLLOW_OFFSET_Y:--2.0}
		follow_z=${PX4_GZ_FOLLOW_OFFSET_Z:-2.0}

		# Set camera offset
		${gz_command} service -s "/gui/follow/offset" --reqtype gz.msgs.Vector3d \
				--reptype gz.msgs.Boolean --timeout 5000 \
				--req "x: ${follow_x}, y: ${follow_y}, z: ${follow_z}" > /dev/null 2>&1

		echo "INFO  [init] Camera follow offset set to ${follow_x}, ${follow_y}, ${follow_z}"
	fi

elif [ -n "${PX4_GZ_MODEL_NAME}" ]; then
	# Connect to existing model
	echo "INFO  [init] PX4_GZ_MODEL_NAME set, PX4 will attach to existing model"
	if ! gz_bridge start -w "${PX4_GZ_WORLD}" -n "${PX4_GZ_MODEL_NAME}"; then
		echo "ERROR [init] gz_bridge failed to start and attach to existing model"
		exit 1
	fi
else
	echo "ERROR [init] failed to pass either PX4_GZ_MODEL_NAME or PX4_SIM_MODEL"
	exit 1
fi

# NOTE: Only for rover_mecanum and spacecraft_2d. All other models have
# the magnetometer sensor in the model.sdf.
if param compare -s SENS_EN_MAGSIM 1
then
	sensor_mag_sim start
fi
# NOTE: new gz has airspeed sensor, remove once added
if param compare -s SENS_EN_ARSPDSIM 1
then
	sensor_airspeed_sim start
fi
