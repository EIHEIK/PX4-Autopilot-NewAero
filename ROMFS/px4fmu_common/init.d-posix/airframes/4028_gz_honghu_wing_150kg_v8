# FW_CANARD_LND_NZ: 接地法向过载阈值 [g]
# FW_CANARD_LND_H2: 无测距传感器时，降落地面参考高度门 [m]
# FW_CANARD_LND_PK: 接地过载峰值保持时间 [s]；V8开启，旧机型默认关闭
param set FW_CANARD_NEUT   0.5
param set FW_CANARD_TO     0.4 # V8 要求 +6 deg 起飞/巡航设定；由 V3 派生状态逻辑在飞行中保持
param set FW_CANARD_BRK    1.0
param set-default FW_CANARD_LND_H  0.1
param set-default FW_CANARD_LND_NZ 1.3
param set-default FW_CANARD_LND_H2 1.0
param set-default FW_CANARD_LND_PK 0.2
# ---------------------------------------------------------------------------
# 其他参数
# ---------------------------------------------------------------------------
param set-default FD_ESCS_EN 0
