#!/bin/sh
#
# @name Canard Honghu Wing V8 PDF Table Rigid Gear (Gazebo SITL)
#
# @type Plane with Canards
# @class Plane
#
# @output Motor1 throttle
# @output Servo1 left aileron
# @output Servo2 right aileron
# @output Servo3 left elevator
# @output Servo4 right elevator
# @output Servo5 left rudder
# @output Servo6 right rudder
# @output Servo7 left canard
# @output Servo8 right canard
# @output Servo9 nose wheel steering
#
# @maintainer <your-email>
#
# NOTE: This airframe matches the Gazebo model honghu_wing_150kg_v8 servo ordering.
# V8 keeps only the validated PX4 channel topology. Aerodynamics, propulsion, CG and rigid ground-contact geometry are independent V8 implementations.
# The nose steering joint is driven by PX4 Landing_Gear_Wheel through Gazebo servo_8.
#   Gazebo servo_0 = left_aileron  -> PX4 CS0
#   Gazebo servo_1 = right_aileron -> PX4 CS1
#   Gazebo servo_2 = left_elevator -> PX4 CS2
#   Gazebo servo_3 = right_elevator-> PX4 CS3
#   Gazebo servo_4 = left_rudder   -> PX4 CS4
#   Gazebo servo_5 = right_rudder  -> PX4 CS5
#   Gazebo servo_6 = left_canard   -> PX4 CS6
#   Gazebo servo_7 = right_canard  -> PX4 CS7
#   Gazebo servo_8 = nose steering -> PX4 Landing_Gear_Wheel

. ${R}etc/init.d/rc.fw_defaults

# ---------------------------------------------------------------------------
# Simulation environment core configuration
# ---------------------------------------------------------------------------
PX4_SIMULATOR=${PX4_SIMULATOR:=gz}
PX4_GZ_WORLD=${PX4_GZ_WORLD:=honghu_v8}
PX4_SIM_MODEL=${PX4_SIM_MODEL:=honghu_wing_150kg_v8}
# The V8 bridge is deterministic at 500 Hz.  Sub-millisecond physics publishes
# clock / pose traffic faster than the SITL bridge can consume in real time and
# can leave the controller acting on stale state.  Keep this overrideable for
# convergence studies, but use the repeatably validated 2 ms operating point.
PX4_GZ_MAX_STEP_SIZE=${PX4_GZ_MAX_STEP_SIZE:=0.002}
# Set the V8 WGS84 origin explicitly at run time. Gazebo may otherwise reuse
# an already-running world whose spherical coordinates came from an older SDF.
PX4_GZ_HOME_LAT=${PX4_GZ_HOME_LAT:=28.5712315}
PX4_GZ_HOME_LON=${PX4_GZ_HOME_LON:=121.5759172}
PX4_GZ_HOME_ALT=${PX4_GZ_HOME_ALT:=0}
PX4_GZ_HOME_HEADING=${PX4_GZ_HOME_HEADING:=0}
PX4_GZ_SET_HOME_COORDINATES=${PX4_GZ_SET_HOME_COORDINATES:=1}
# Preserve the original geographic XY mission: its takeoff leg is true bearing
# 24.97 deg. In an ENU world this corresponds to a +65.03 deg model yaw.
# The dynamic acceptance tool overrides this to yaw=0 for its eastbound route.
PX4_GZ_MODEL_POSE=${PX4_GZ_MODEL_POSE:=0,0,0.5145,0,0,1.1349764}
export PX4_GZ_MAX_STEP_SIZE PX4_GZ_HOME_LAT PX4_GZ_HOME_LON PX4_GZ_HOME_ALT PX4_GZ_HOME_HEADING PX4_GZ_SET_HOME_COORDINATES PX4_GZ_MODEL_POSE

param set-default SIM_GZ_EN 1
param set-default SENS_EN_GPSSIM 1
param set-default SENS_EN_MAGSIM 1
param set-default SENS_EN_ARSPDSIM 1

# Airspeed and safety limits (tuned for simulation stability)
# Critical taxi-test baseline parameters below use "param set" instead of
# "param set-default" so stale parameters.bson values from earlier tuning runs
# cannot override the known-good V6/V7 ground tracking baseline.
param set FW_AIRSPD_STALL 30     # 失速空速 [m/s]
param set FW_AIRSPD_MIN 32       # TECS 使用的最小可控空速 [m/s]，需不低于失速空速
param set FW_AIRSPD_TRIM 40      # 巡航/配平空速 [m/s]
param set FW_AIRSPD_MAX 55       # 最大允许空速 [m/s]
param set-default FW_TKO_AIRSPD 40       # 起飞爬升阶段目标空速 [m/s]
param set-default FW_LND_AIRSPD 30       # 降落进近目标空速 [m/s]
param set FW_THR_MAX 1.0                # V8 起飞需覆盖 PDF 发动机表的 100% 工况
param set-default FW_THR_SLEW_MAX 0.30   # 最大油门变化率 [1/s]
param set-default FW_T_CLMB_MAX 4.0      # FW_THR_MAX 油门下的最大爬升能力 [m/s]
param set-default FW_T_CLMB_R_SP 4.0     # 默认爬升率设定 [m/s]
param set-default FW_T_SINK_R_SP 3.0     # 默认下降率设定 [m/s]
param set-default FW_T_SINK_MAX 3.0      # TECS 允许的最大下降率 [m/s]
param set-default FW_T_SPDWEIGHT 1.0     # TECS 速度/高度平衡权重
# Airborne height loop: retain both TECS and rate-loop integrators so unknown
# real-aircraft trim can be learned, while adding enough damping and response
# to reject the documented thrust-line pitching moment.
param set FW_T_I_GAIN_PIT 0.05           # retained TECS pitch integrator; faster than the stable 0.03 probe
param set FW_T_PTCH_DAMP 0.15            # energy-balance-rate damping for the long-period height mode
param set FW_T_ALT_TC 3.5                 # reduce the level-handoff height dip without exciting the phugoid
param set FW_T_RLL2THR 20                 # bank-angle throttle compensation preserves height in sustained turns
param set FW_P_LIM_MAX 8                 # 和缓抬头设定上限 [deg]；Gazebo 真值俯仰必须不超过 12 deg
param set-default FW_P_LIM_MIN -10       # 最大低头/俯冲设定 [deg]
param set-default FW_TKO_PITCH_MIN 8     # 抬轮后的最小爬升俯仰角 [deg]
# V8 airborne pitch-rate loop. The PDF engine position and 3 deg down-thrust
# produce a real nose-down throttle coupling, so the earlier weak V3-style
# gains only balanced the engine moment and left no pull-out margin. These use
# "param set" intentionally so stale parameters.bson values cannot restore it.
param set TRIM_PITCH 0.03        # nominal 40 m/s pitch trim; integrators remain active for unknown real trim
param set FW_PR_D 0.10           # airborne pitch angular-acceleration damping at the validated 2 ms step
param set FW_PR_FF 0.75          # tracks the existing 6 deg/s command during 30 deg banks; runway boost remains separate
param set FW_PR_FF_RWTO 6.6      # 跑道解锁前馈；2 deg/s内退回空中前馈，兼顾早抬轮与低过冲
param set FW_PR_RWTO_Q 2.0       # 机头开始转动后在 2 deg/s 内释放跑道助力，兼顾抬轮与过冲
param set FW_PR_I 0.04           # retained pitch-rate integrator for CG/servo/aero trim changes
param set FW_PR_IMAX 0.12        # bounded trim authority preserves turn pull-up margin without dominating reversals
param set FW_PR_P 0.40           # closes banked-flight rate error without removing the real-trim integrator
param set FW_P_TC 0.8            # airborne pitch attitude outer-loop time constant [s]
param set FW_P_RMAX_POS 6        # 和缓抬头：最大正俯仰角速度设定 [deg/s]
param set FW_P_RMAX_NEG 10       # symmetric-enough nose-down limit avoids exciting the long-period mode

param set FW_RR_D 0.06           # reversal damping for the no-foldback 30 deg course-change acceptance route
param set FW_RR_FF 1.45          # supplies the measured authority needed to follow a 20 deg/s rate command
param set FW_RR_I 0.05           # retain real-aircraft trim rejection while limiting reversal integral memory
param set FW_RR_IMAX 0.20        # roll rate integral limit
param set FW_RR_P 0.26           # reduces sustained roll-command phase lag without aileron saturation
param set FW_R_TC 0.65           # validated airborne roll attitude outer-loop time constant [s]
param set FW_R_LIM 30            # validated test ceiling; 40 m/s coordinated level-turn radius about 283 m
param set FW_R_RMAX 20           # validated maximum airborne roll-rate setpoint [deg/s]
param set FW_PN_R_SLEW_MAX 20    # match NPFG roll-command slew to the validated inner-loop bandwidth
param set NPFG_PERIOD 20.0       # latest clean QGC logs: smoother early turns, less roll saturation and smaller height/airspeed excursions
param set NPFG_DAMPING 0.80      # reduce S-turn overshoot while retaining useful cross-track convergence
param set NPFG_ROLL_TC 1.30      # measured candidate-2 roll response model used by NPFG stability period bounds
param set NPFG_SW_DST_MLT 0.32   # validated line-following baseline; larger values chase the next leg extension rather than a circular fillet

param set-default MIS_TAKEOFF_ALT 45     # 默认任务起飞高度 [m]
param set NAV_ACC_RAD 250                # mission acceptance lower bound; this alone does not create a fixed-wing circular fly-by [m]
param set-default NAV_LOITER_RAD 800     # 任务导航使用的盘旋/转弯半径 [m]
param set-default FW_LND_ANG 4           # 最终进近下滑角 [deg]
param set-default FW_LND_USETER 0        # 禁用地形估计触发拉平
param set-default FW_LND_ABORT 0         # 禁用基于地形条件的自动降落中止
param set-default FW_LND_FLALT 6         # 相对降落点的最小拉平高度 [m]
param set-default FW_LND_FL_TIME 2.0     # 动态拉平时间系数 [s]
param set-default FW_LND_FL_SINK 0.6     # 拉平阶段目标下沉率 [m/s]
param set-default FW_LND_FL_PMIN 1       # 拉平阶段最小俯仰角 [deg]
param set-default FW_LND_FL_PMAX 8       # 拉平阶段最大俯仰角 [deg]
param set-default FW_LND_TD_TIME 3.0     # 拉平开始后的预计接地时间 [s]
param set-default FW_LND_THRTC_SC 0.6    # 低高度 TECS 高度时间常数缩放系数
param set-default FW_T_THR_LOW_HGT 30    # 低于该高度时启用更紧的 TECS 高度跟踪 [m]
param set-default RWTO_TKOFF 1           # 启用跑道起飞逻辑
param set RWTO_MAX_THR 1.0              # 35 m/s 后继续加速所需，避免 75% 推力与阻力平衡
param set-default RWTO_RAMP_TIME 5.0     # 从怠速爬升到 RWTO_MAX_THR 的时间 [s]
param set-default RWTO_ROT_TIME 1.0      # 一秒内建立起飞俯仰约束，避免高速长距离拖轮
param set RWTO_TAXI_TEST 0               # 地面滑行测试模式：1=仅用于低速地面滑跑测试，正式起飞必须保持0
param set RWTO_TAXI_TOFF 0               # 历史兼容参数；正式起飞不再通过该参数串接滑跑测试逻辑
param set RWTO_TAXI_THR 0.10     # 旧开环滑行油门保留给RunwayTakeoff内部兼容分支
param set RWTO_TAXI_SPD 8.0      # 独立地面滑跑测试目标地速 [m/s]，先降速验证起落架接触稳定性
param set RWTO_TAXI_THR_FF 0.13  # 刚性滑块约30-40N稳态阻力对应的油门前馈
param set RWTO_TAXI_TMIN 0.00    # 地面滑跑速度闭环最小油门 [0,1]
param set RWTO_TAXI_TMAX 0.35    # 地面滑跑速度闭环最大油门 [0,1]
param set RWTO_TAXI_SPD_P 0.025  # 地面滑跑速度比例增益
param set RWTO_TAXI_SPD_I 0.0005 # 慢积分避免启动阶段积累后冲击10m/s保护阈值
param set RWTO_TAXI_ARSP 10.0    # 地面滑行测试最大空速 [m/s]，超过后降到怠速
param set RWTO_TAXI_GSPD 10.0    # 地面滑行测试最大地速 [m/s]，超过后降到怠速
param set RWTO_TAXI_XTK_P 0.010  # 前轮执行力修复后的有界横偏增益 [rad/m]
param set RWTO_TAXI_ACC 12.0     # 地面滑跑任务航点默认到达半径 [m]
param set RWTO_TAXI_XMAX 20.0    # 地面滑跑最大航向修正角 [deg]，避免刚性轮胎过控
param set RWTO_TAXI_YRMAX 15.0   # 地面滑跑航向设定变化率上限 [deg/s]
param set RWTO_TAXI_TIME 180.0   # 地面滑行测试最大时长 [s]，0=不按时间自动收油
param set-default RWTO_PSP 0.0           # 滑跑/抬轮前俯仰设定 [deg]
param set-default RWTO_ROT_AIRSPD 35.0  # 鸭翼展开 + 抬轮触发空速 [m/s]，需按实际失速速度调整

param set RWTO_WHEEL_HGT 0.20            # 旋转后保留前轮闭环至刚离地；0 对旧机型保持原行为
param set RWTO_HDG 1            # 起飞滑跑前轮跟随航线方位(1=跟随航线, 0=锁定初始航向)
param set RWTO_DIR_MIN 50       # coincident TAKEOFF point defines altitude only; use the next mission waypoint for runway direction [m]
param set-default RWTO_NPFG_PERIOD 8.0   # 跑道转向阶段使用较慢的横向制导周期 [s]
param set FW_W_EN 1              # 启用跑道滑跑/降落用前轮转向控制器
param set FW_W_TC 2.50           # 前轮执行力修复后放慢航向外环，避免低速过控
param set FW_WR_P 0.25           # 约1deg级轮角权威；5deg扰动试验保持可控并出现回线趋势
param set FW_WR_I 0.00           # 仿真无恒定转向偏置；禁用初始航向捕获造成的积分残留
param set FW_WR_IMAX 0.30        # 前轮积分输出上限，防止地面持续饱和
param set FW_WR_FF 0.08          # 降低前馈，避免反打前积累过大的偏航惯性
param set FW_W_RMAX 20.0         # 限制地面目标偏航角速度 [deg/s]
param set FW_W_GSPD_SC 5.0       # 5m/s以上按地速降低前轮权威，保护高速起飞滑跑
param set EKF2_GPS_CHECK 0       # 仿真地面滑跑关闭 EKF GPS 质量门限，避免航向/位置初始化失败
param set EKF2_REQ_HDRIFT 5.0    # 仿真地面滑行时放宽 GPS 静止水平漂移/速度检查，避免短暂位置 failsafe

# ---------------------------------------------------------------------------
# Topology definition: 8 control surfaces matching Gazebo model
# ---------------------------------------------------------------------------
param set-default CA_AIRFRAME 1
param set-default CA_ROTOR_COUNT 1
param set-default CA_ROTOR0_PX -1.23
param set-default CA_SV_CS_COUNT 8

# ---------------------------------------------------------------------------
# Control allocation mapping (matches Gazebo servo_0..servo_7 order).
# Paired conventional surfaces use Custom so the explicit 0.5 effectiveness
# is preserved; canards use V3 state-machine types 19/20 and never enter pitch allocation.
# ---------------------------------------------------------------------------
# 0: Left Aileron -- roll control
param set-default CA_SV_CS0_TYPE  12
param set-default CA_SV_CS0_TRQ_R -0.5

# 1: Right Aileron -- roll control
param set-default CA_SV_CS1_TYPE  12
param set-default CA_SV_CS1_TRQ_R 0.5

# 2: Left Elevator -- pitch control
param set-default CA_SV_CS2_TYPE  12
param set-default CA_SV_CS2_TRQ_P 0.5

# 3: Right Elevator -- pitch control
param set-default CA_SV_CS3_TYPE  12
param set-default CA_SV_CS3_TRQ_P 0.5

# 4: Left Rudder -- yaw control
param set-default CA_SV_CS4_TYPE  12
param set-default CA_SV_CS4_TRQ_Y 0.5

# 5: Right Rudder -- yaw control
param set-default CA_SV_CS5_TYPE  12
param set-default CA_SV_CS5_TRQ_Y 0.5

# 6: Left Canard -- auxiliary pitch via canard state machine
param set-default CA_SV_CS6_TYPE  19
param set-default CA_SV_CS6_CANARD 1.0

# 7: Right Canard -- auxiliary pitch via canard state machine
param set-default CA_SV_CS7_TYPE  20
param set-default CA_SV_CS7_CANARD 1.0

# ---------------------------------------------------------------------------
# Gazebo simulation output bridge
# ---------------------------------------------------------------------------
# V8 uses a true zero-angle point for every channel. This is essential for
# the asymmetric -50/0/+15 deg canard travel.
param set SIM_GZ_SV_ZMAP 1
param set SIM_GZ_SV_MINA1 -30
param set SIM_GZ_SV_ZEROA1 0
param set SIM_GZ_SV_MAXA1 30
param set SIM_GZ_SV_MINA2 -30
param set SIM_GZ_SV_ZEROA2 0
param set SIM_GZ_SV_MAXA2 30
param set SIM_GZ_SV_MINA3 -30
param set SIM_GZ_SV_ZEROA3 0
param set SIM_GZ_SV_MAXA3 30
param set SIM_GZ_SV_MINA4 -30
param set SIM_GZ_SV_ZEROA4 0
param set SIM_GZ_SV_MAXA4 30
param set SIM_GZ_SV_MINA5 -30
param set SIM_GZ_SV_ZEROA5 0
param set SIM_GZ_SV_MAXA5 30
param set SIM_GZ_SV_MINA6 -30
param set SIM_GZ_SV_ZEROA6 0
param set SIM_GZ_SV_MAXA6 30
param set SIM_GZ_SV_MINA7 -50
param set SIM_GZ_SV_ZEROA7 0
param set SIM_GZ_SV_MAXA7 15
param set SIM_GZ_SV_MINA8 -50
param set SIM_GZ_SV_ZEROA8 0
param set SIM_GZ_SV_MAXA8 15
param set SIM_GZ_SV_MINA9 30
param set SIM_GZ_SV_ZEROA9 0
param set SIM_GZ_SV_MAXA9 -30

param set-default SIM_GZ_EC_FUNC1 101 # Motor 1 throttle

param set-default SIM_GZ_SV_FUNC1 201 # Servo 1 -> CS0 (left aileron)
param set-default SIM_GZ_SV_FUNC2 202 # Servo 2 -> CS1 (right aileron)
param set-default SIM_GZ_SV_FUNC3 203 # Servo 3 -> CS2 (left elevator)
param set-default SIM_GZ_SV_FUNC4 204 # Servo 4 -> CS3 (right elevator)
param set-default SIM_GZ_SV_FUNC5 205 # Servo 5 -> CS4 (left rudder)
param set-default SIM_GZ_SV_FUNC6 206 # Servo 6 -> CS5 (right rudder)
param set-default SIM_GZ_SV_FUNC7 207 # Servo 7 -> CS6 (left canard)
param set-default SIM_GZ_SV_FUNC8 208 # Servo 8 -> CS7 (right canard)
param set-default SIM_GZ_SV_FUNC9 440 # Servo 9 -> Landing_Gear_Wheel (nose steering)

# 前轮转向符号：PX4 正偏航/右转映射到 Gazebo 负关节角；正 Gazebo 关节角产生左转。
param set-default SIM_GZ_SV_DIS9 500
param set-default SIM_GZ_SV_MIN9 0
param set-default SIM_GZ_SV_MAX9 1000
param set-default SIM_GZ_SV_FAIL9 500

param set SIM_GZ_EC_MIN1 0
param set SIM_GZ_EC_MAX1 1000
param set-default FD_ESCS_EN 0

# ---------------------------------------------------------------------------
# Canard state machine parameters
# ---------------------------------------------------------------------------
# FW_CANARD_TO:  Takeoff cruise canard setting (0=neutral, 1=max trailing-edge-down)
param set FW_CANARD_NEUT   0.5
param set FW_CANARD_TO     0.266667 # +4 deg PDF takeoff/trim baseline; retained in flight as in V3
# FW_CANARD_BRK: Aerodynamic braking canard setting (0=neutral, 1=max trailing-edge-up)
param set FW_CANARD_BRK    1.0
# FW_CANARD_LND_H:  Touchdown AGL height threshold [m]
param set-default FW_CANARD_LND_H  0.1
# FW_CANARD_LND_NZ: Touchdown normal load factor threshold [g]
param set-default FW_CANARD_LND_NZ 1.5
