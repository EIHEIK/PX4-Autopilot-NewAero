#!/bin/sh
#
# @name Honghu Wing V8 Xiangyi 100 kg Isolated Test
#
# @type Plane with Canards
# @class Plane
#
# @output Motor1 throttle
# @output Servo1 left aileron
# @output Servo2 right aileron
# @output Servo3 left elevator
# @output Servo4 right elevator
# @output Servo5 left rudder
# @output Servo6 right rudder
# @output Servo7 left canard
# @output Servo8 right canard
# @output Servo9 nose wheel steering
#
# Test-only derivative of 4028. It deliberately sources the validated 150 kg
# control/channel baseline, then applies only Xiangyi-condition overrides.
# Do not use this airframe as the production Honghu V8 baseline.

PX4_SIM_MODEL=honghu_wing_100kg_v8_xiangyi_test

. ${R}etc/init.d-posix/airframes/4028_gz_honghu_wing_150kg_v8

# Xiangyi's confirmed simulation mass is 100 kg. The square-root mass scaling
# from the validated 150 kg V8 predicts a 35.9 m/s lift-off condition.
param set FW_AIRSPD_STALL 24.5
param set FW_AIRSPD_MIN 26.0
param set FW_AIRSPD_TRIM 45.0
param set FW_AIRSPD_MAX 55.0
param set FW_TKO_AIRSPD 35.0
param set RWTO_ROT_AIRSPD 30.0

# Xiangyi's two complete flights hold the canard close to +6 deg. V8's joint
# mapping uses +15 deg at a normalized takeoff command of 1.
param set FW_CANARD_TO 0.4

# 2026-08-04 bounded rate identification and repeated AUTO routes established
# this 100 kg-only longitudinal baseline. Subsequent full-route testing with
# phase-isolated gains increased only the cruise P feedback to 1.30; takeoff
# and landing retain the original 0.90 value. The integrator remains enabled
# for unknown trim in every phase.
param set FW_PR_FF 0.60
param set FW_PR_P 1.30
param set FW_PR_I 0.04
param set FW_PR_D 0.04
# Keep the validated near-ground controller independent from the stronger
# cruise feedback. The existing 50 m / 5 s phase schedule blends these gains
# without resetting the pitch-rate integrator. A 2026-08-05 full-route test
# reduced cruise pitch HP activity by 16% and height RMS by 11%, without
# increasing elevator HP activity.
param set FW_PR_P_TKO 0.90
param set FW_PR_I_TKO 0.04
param set FW_PR_D_TKO 0.04
param set FW_PR_P_LND 0.90
param set FW_PR_I_LND 0.04
param set FW_PR_D_LND 0.04
param set FW_P_TC 0.80
param set FW_P_TC_TKO 0.80
param set FW_P_TC_LND 0.80

# Keep the physical elevator trim approximately constant over the 40--50 m/s
# envelope. PX4 scales TRIM_PITCH with inverse airspeed squared; the official
# DTRIM schedule compensates that scaling while the retained rate integrator
# removes the remaining model/operating-point error.
param set TRIM_PITCH -0.125
param set FW_DTRIM_P_VMIN 0.12
param set FW_DTRIM_P_VMAX -0.05
# Full-route A/B tests on the 100 kg plant showed that reducing the cruise roll
# limit from 30 to 25 deg reduced mean turn height loss by about 30%, pitch
# activity by about 21%, and elevator activity by about 18%. NPFG cross-track
# RMS increased by only about 3%. Keep this override isolated from the
# validated 150 kg 4028 airframe.
param set FW_R_LIM 25
# 2026-08-05 correction: whole-flight averages hid a growing 0.24 Hz mode.
# TECS replay proved that SEB_R_FF=1.0 and PTCH_DAMP=0.15 contributed in phase
# in the affected operating point. Two complete missions with the official
# minimum SEB feedforward and zero energy-rate damping changed the response
# from growing to decaying: pitch HP std 0.253--0.255 deg, worst 30 s std
# 0.523--0.530 deg, and final/initial window ratio 0.53--0.58. Both flights
# completed the mission; the touchdown repeat retained the existing landing
# and canard-brake behavior. The pitch integrator remains enabled.
param set FW_T_PTCH_DAMP 0.0
param set FW_T_I_GAIN_PIT 0.05
param set FW_T_ALT_TC 4.5
param set FW_T_SEB_R_FF 0.5
