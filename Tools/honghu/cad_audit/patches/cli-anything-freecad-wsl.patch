@@ -124,6 +124,38 @@ def find_freecad(gui_required: bool = False) -> str:
     raise RuntimeError(_INSTALL_INSTRUCTIONS)
 
 
+def _uses_windows_freecad(freecad: str) -> bool:
+    """Return True when WSL is launching a Windows FreeCAD executable."""
+    return platform.system() == "Linux" and freecad.lower().endswith(".exe")
+
+
+def path_for_freecad(path: str, freecad: Optional[str] = None) -> str:
+    """Translate a WSL path to a Windows/UNC path when required.
+
+    Native Linux and macOS FreeCAD installations receive the original absolute
+    path. A Windows executable launched through WSL receives the value emitted
+    by ``wslpath -w`` so that macro, input, and output files remain reachable.
+    """
+    absolute = str(Path(path).resolve())
+    executable = freecad or find_freecad()
+    if not _uses_windows_freecad(executable):
+        return absolute
+
+    try:
+        converted = subprocess.run(
+            ["wslpath", "-w", absolute],
+            capture_output=True,
+            text=True,
+            timeout=10,
+            check=True,
+        ).stdout.strip()
+    except (FileNotFoundError, subprocess.CalledProcessError, subprocess.TimeoutExpired) as exc:
+        raise RuntimeError(f"Failed to translate WSL path for Windows FreeCAD: {absolute}: {exc}") from exc
+    if not converted:
+        raise RuntimeError(f"wslpath returned an empty path for: {absolute}")
+    return converted
+
+
