    <link name="right_elevator">
      <pose relative_to="base_link">0 0 0 0 0 0</pose>
      <gravity>true</gravity>
      <inertial>
        <pose>-0.7665 -0.39402 0.41184 0 0 0</pose>
        <mass>0.02</mass>
        <inertia>
          <ixx>3.07e-06</ixx><ixy>0</ixy><ixz>0</ixz>
