    </joint>

    <!-- Phase-1 rigid main gear: carrier fixed in base_link, wheel spins freely. -->
    <joint name="left_main_wheel_joint" type="revolute">
      <parent>base_link</parent><child>left_main_wheel</child>
      <pose relative_to="base_link">-0.291274 0.524303 -0.4551 0 0 0</pose>
      <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit><dynamics><friction>0.02</friction></dynamics></axis>
    </joint>
    <link name="left_main_wheel">
      <pose relative_to="left_main_wheel_joint">0 0 0 0 0 0</pose>
      <gravity>true</gravity>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.000364</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000353</iyy><iyz>0</iyz><izz>0.000364</izz>
        </inertia>
      </inertial>
      <visual name="wheel_visual"><pose>1.861274 -0.524303 0.4551 0 0 0</pose><geometry><mesh><uri>meshes/left_backwheel.dae</uri></mesh></geometry></visual>
      <collision name="left_main_wheel_collision">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry><cylinder><radius>0.0594</radius><length>0.1060</length></cylinder></geometry>
        <surface>
          <contact><ode><kp>2000000</kp><kd>20000</kd><max_vel>0.2</max_vel><min_depth>0.0005</min_depth></ode></contact>
          <!-- Rigid strut, real rolling wheel: the revolute spin joint supplies
               longitudinal rolling while lateral tire grip stabilizes tracking. -->
          <friction><ode><mu>0.8</mu><mu2>2.0</mu2><fdir1>1 0 0</fdir1></ode></friction>
        </surface>
      </collision>
    </link>

    <!-- Phase-1 rigid main gear: carrier fixed in base_link, wheel spins freely. -->
    <joint name="right_main_wheel_joint" type="revolute">
      <parent>base_link</parent><child>right_main_wheel</child>
      <pose relative_to="base_link">-0.291274 -0.524303 -0.4551 0 0 0</pose>
      <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit><dynamics><friction>0.02</friction></dynamics></axis>
    </joint>
    <link name="right_main_wheel">
      <pose relative_to="right_main_wheel_joint">0 0 0 0 0 0</pose>
      <gravity>true</gravity>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.000364</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000353</iyy><iyz>0</iyz><izz>0.000364</izz>
        </inertia>
      </inertial>
      <visual name="wheel_visual"><pose>1.861274 0.524303 0.4551 0 0 0</pose><geometry><mesh><uri>meshes/right_backwheel.dae</uri></mesh></geometry></visual>
      <collision name="right_main_wheel_collision">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry><cylinder><radius>0.0594</radius><length>0.1060</length></cylinder></geometry>
        <surface>
          <contact><ode><kp>2000000</kp><kd>20000</kd><max_vel>0.2</max_vel><min_depth>0.0005</min_depth></ode></contact>
          <!-- Rigid strut, real rolling wheel: the revolute spin joint supplies
               longitudinal rolling while lateral tire grip stabilizes tracking. -->
          <friction><ode><mu>0.8</mu><mu2>2.0</mu2><fdir1>1 0 0</fdir1></ode></friction>
        </surface>
      </collision>
    </link>

    <!-- Rigid nose carrier with retained steering and free wheel spin. -->
    <joint name="nose_steering_joint" type="revolute">
      <parent>base_link</parent><child>nose_steering_fork</child>
      <pose relative_to="base_link">0.924852 0 -0.4706 0 0 0</pose>
      <axis><xyz>0 0 1</xyz><limit><lower>-0.523599</lower><upper>0.523599</upper><effort>300</effort><velocity>3</velocity></limit>
        <dynamics><damping>0.05</damping><friction>0.001</friction></dynamics></axis>
    </joint>
    <link name="nose_steering_fork">
      <pose relative_to="nose_steering_joint">0 0 0 0 0 0</pose>
      <gravity>true</gravity>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.05</mass>
        <inertia>
          <ixx>5e-05</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>5e-05</iyy><iyz>0</iyz><izz>5e-05</izz>
        </inertia>
      </inertial>
    </link>
    <joint name="nose_wheel_spin_joint" type="revolute">
      <parent>nose_steering_fork</parent><child>nose_wheel</child>
      <pose relative_to="nose_steering_fork">0 0 0 0 0 0</pose>
      <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit><dynamics><friction>0.02</friction></dynamics></axis>
    </joint>
    <link name="nose_wheel">
      <pose relative_to="nose_wheel_spin_joint">0 0 0 0 0 0</pose>
      <gravity>true</gravity>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.15</mass>
        <inertia>
          <ixx>0.000304</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000145</iyy><iyz>0</iyz><izz>0.000304</izz>
        </inertia>
      </inertial>
      <visual name="wheel_visual"><pose>0.645148 0 0.457844 0 0 0</pose><geometry><mesh><uri>meshes/steeringwheel.dae</uri></mesh></geometry></visual>
      <collision name="nose_wheel_collision">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry><cylinder><radius>0.0439</radius><length>0.1363</length></cylinder></geometry>
        <surface>
          <contact><ode><kp>2000000</kp><kd>20000</kd><max_vel>0.2</max_vel><min_depth>0.0005</min_depth></ode></contact>
          <!-- Rigid strut, real rolling wheel: the revolute spin joint supplies
               longitudinal rolling while lateral tire grip stabilizes tracking. -->
          <friction><ode><mu>1.2</mu><mu2>3.0</mu2><fdir1>1 0 0</fdir1></ode></friction>
        </surface>
      </collision>
    </link>
